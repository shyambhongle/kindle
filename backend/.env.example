# Copy to .env (or secrets/.env) and fill in. Never commit the real file.

# Where to listen. Set your Mac's LAN IP, not 0.0.0.0: on 0.0.0.0 anyone on the Wi-Fi can
# reach /admin, and the access token in the URL is the only thing stopping them.
# Find it with: ipconfig getifaddr en0
LISTEN_ADDR=192.168.1.20:8080

# Postgres. deploy/setup-postgres.sql creates the role with a random password and prints the
# line to paste here. Do not ship a password you would recognise.
DATABASE_URL=postgres://dashboard:PASTE_FROM_setup-postgres.sql@localhost:5432/dashboard?sslmode=disable

# Long random string. Generate with: ./dashboard token
ACCESS_TOKEN=

# Time zone for "today", calendar times and the daily rotation
TZ=Asia/Kolkata

# How often the collector pulls Notion, calendar, weather and news
COLLECT_EVERY=15m

# Weather (Open-Meteo, no key). Seeds the home place on first run; manage places in the web dashboard after that.
WEATHER_LAT=18.5204
WEATHER_LON=73.8567
WEATHER_LOCATION=Pune

# Notion: internal integration token + the tasks database id (32 hex chars from the database URL).
# Leave empty to use dummy tasks.
NOTION_TOKEN=
NOTION_TASKS_DB=
# How your board's statuses reach the Kindle. Names must match the status options exactly (case ignored).
NOTION_STATUS_PROP=Status
NOTION_STATUS_TOP=Priority
NOTION_STATUS_NEXT=In Progress
NOTION_STATUS_BACKLOG=All Task
NOTION_STATUS_HIDDEN=Parked
NOTION_STATUS_DONE=Done

# Google Calendar: Settings > your calendar > "Secret address in iCal format". Leave empty for dummy events.
CALENDAR_ICS_URL=

# Claude API: generates the German quizzes and Saturday tests and the English daily pack.
# Get a key at console.anthropic.com. A day of both costs a few rupees at Sonnet prices.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5
# Course day 1. Defaults to start_date in data/german/course.yaml (2026-11-02). Override here if you start later.
GERMAN_START_DATE=

# Backups: compressed pg_dump files, written at start and every 24 h, newest 30 kept.
BACKUP_DIR=backups
DAILY_BACKUP=true

# Force dummy data for every external source (useful while building the UI)
MOCK=false
